# Copie para backend/.env e ajuste. O .env NÃO vai para o git.
# Gere senhas fortes e a SECRET_KEY (ex.: openssl rand -hex 32) na primeira instalação.

# Servidor web: papel RESTRITO (só lê o acervo e acrescenta histórico)
DATABASE_URL=postgresql://acervo_app:TROQUE@localhost:5432/crepop
# Scripts de linha de comando (migrar, ingerir, criar usuário): dono das tabelas
DATABASE_URL_ADMIN=postgresql://postgres:TROQUE@localhost:5432/crepop

# Assina o cookie de login. Gere com: openssl rand -hex 32
SECRET_KEY=TROQUE

# Ollama local (mesma VM)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=acervo-psico
EMBED_MODEL=embeddinggemma
COLUNA_VETOR=vetor_conteudo_2
IA_PENSAR=false

# RAG e limites (opcionais; estes são os padrões)
TOP_K=3
CONTEXTO_CHARS=1000
LIMITE_BUSCAS_MIN=30
LIMITE_PERGUNTAS_MIN=3
FILA_IA_MAX=4
